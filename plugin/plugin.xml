<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.commands">
      <command id="io.github.p3chys.documentationarchi.export" name="Export Documentation..."
            description="Export the selected model, views or elements as HTML, PDF and Confluence pages"/>
      <command id="io.github.p3chys.documentationarchi.printOrder" name="Print Order..."
            description="Set the order in which the documentation export describes the elements of the view"/>
      <command id="io.github.p3chys.documentationarchi.addAsset" name="Add Asset..."
            description="Copy files into the model's Assets folder and refer to them in the description"/>
      <command id="io.github.p3chys.documentationarchi.linkWorkPackage" name="Link to Work Package..."
            description="Link the selected elements to the work packages (Jira tickets) that change them"/>
      <command id="io.github.p3chys.documentationarchi.workPackages" name="Work Packages..."
            description="The work packages (Jira tickets) of the model, the elements they change, and their export"/>
      <command id="io.github.p3chys.documentationarchi.keywordStyles" name="Documentation Formatting..."
            description="How the documentation export formats headings, tokens, SQL and keywords"/>
      <command id="io.github.p3chys.documentationarchi.describeHere" name="Describe Here"
            description="Describe the selected elements on this view's page of the documentation export"/>
      <command id="io.github.p3chys.documentationarchi.insertReference" name="Insert Reference..."
            description="Refer to another element or view in the description, by its current name"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler commandId="io.github.p3chys.documentationarchi.export" class="io.github.p3chys.documentationarchi.ui.ExportHandler"/>
      <handler commandId="io.github.p3chys.documentationarchi.printOrder" class="io.github.p3chys.documentationarchi.ui.PrintOrderHandler"/>
      <handler commandId="io.github.p3chys.documentationarchi.addAsset" class="io.github.p3chys.documentationarchi.ui.AddAssetHandler"/>
      <handler commandId="io.github.p3chys.documentationarchi.linkWorkPackage" class="io.github.p3chys.documentationarchi.ui.WorkPackageHandler"/>
      <handler commandId="io.github.p3chys.documentationarchi.workPackages" class="io.github.p3chys.documentationarchi.ui.WorkPackagesHandler"/>
      <handler commandId="io.github.p3chys.documentationarchi.keywordStyles" class="io.github.p3chys.documentationarchi.ui.KeywordStylesHandler"/>
      <handler commandId="io.github.p3chys.documentationarchi.describeHere" class="io.github.p3chys.documentationarchi.ui.DescribeHereHandler"/>
      <handler commandId="io.github.p3chys.documentationarchi.insertReference" class="io.github.p3chys.documentationarchi.ui.InsertReferenceHandler"/>
   </extension>

   <extension point="org.eclipse.core.expressions.definitions">
      <definition id="io.github.p3chys.documentationarchi.exportable">
         <with variable="activeMenuSelection">
            <iterate ifEmpty="false" operator="or">
               <or>
                  <instanceof value="com.archimatetool.model.IArchimateModelObject"/>
                  <instanceof value="org.eclipse.gef.EditPart"/>
               </or>
            </iterate>
         </with>
      </definition>
      <definition id="io.github.p3chys.documentationarchi.assetTarget">
         <with variable="activeMenuSelection">
            <and>
               <count value="1"/>
               <iterate>
                  <or>
                     <instanceof value="com.archimatetool.model.IDocumentable"/>
                     <instanceof value="com.archimatetool.model.ITextContent"/>
                     <instanceof value="com.archimatetool.model.IArchimateModel"/>
                     <instanceof value="org.eclipse.gef.EditPart"/>
                  </or>
               </iterate>
            </and>
         </with>
      </definition>
      <definition id="io.github.p3chys.documentationarchi.elements">
         <with variable="activeMenuSelection">
            <iterate ifEmpty="false" operator="or">
               <or>
                  <instanceof value="com.archimatetool.model.IArchimateElement"/>
                  <instanceof value="org.eclipse.gef.EditPart"/>
               </or>
            </iterate>
         </with>
      </definition>
      <definition id="io.github.p3chys.documentationarchi.archimateView">
         <with variable="activeMenuSelection">
            <and>
               <count value="1"/>
               <iterate><instanceof value="com.archimatetool.model.IArchimateDiagramModel"/></iterate>
            </and>
         </with>
      </definition>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="menu:tools?after=additions">
         <command commandId="io.github.p3chys.documentationarchi.keywordStyles"/>
      </menuContribution>
      <menuContribution locationURI="popup:com.archimatetool.editor.treeModelView?after=additions">
         <command commandId="io.github.p3chys.documentationarchi.export">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.exportable"/></visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:com.archimatetool.editor.treeModelView?after=additions">
         <command commandId="io.github.p3chys.documentationarchi.addAsset">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.assetTarget"/></visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:com.archimatetool.editor.treeModelView?after=additions">
         <command commandId="io.github.p3chys.documentationarchi.printOrder">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.archimateView"/></visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:com.archimatetool.editor.treeModelView?after=additions">
         <command commandId="io.github.p3chys.documentationarchi.linkWorkPackage">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.elements"/></visibleWhen>
         </command>
         <command commandId="io.github.p3chys.documentationarchi.workPackages">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.exportable"/></visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:ArchimateDiagramEditorContextMenuProvider?after=group_export">
         <command commandId="io.github.p3chys.documentationarchi.addAsset">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.assetTarget"/></visibleWhen>
         </command>
         <command commandId="io.github.p3chys.documentationarchi.export">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.exportable"/></visibleWhen>
         </command>
         <command commandId="io.github.p3chys.documentationarchi.printOrder">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.exportable"/></visibleWhen>
         </command>
         <command commandId="io.github.p3chys.documentationarchi.linkWorkPackage">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.exportable"/></visibleWhen>
         </command>
         <command commandId="io.github.p3chys.documentationarchi.workPackages">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.exportable"/></visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:ArchimateDiagramEditorContextMenuProvider?after=group_export">
         <command commandId="io.github.p3chys.documentationarchi.describeHere">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.elements"/></visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:SketchEditorContextMenuProvider?after=group_export">
         <command commandId="io.github.p3chys.documentationarchi.addAsset">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.assetTarget"/></visibleWhen>
         </command>
         <command commandId="io.github.p3chys.documentationarchi.export">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.exportable"/></visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:CanvasEditorContextMenuProvider?after=group_export">
         <command commandId="io.github.p3chys.documentationarchi.addAsset">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.assetTarget"/></visibleWhen>
         </command>
         <command commandId="io.github.p3chys.documentationarchi.export">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.exportable"/></visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:com.archimatetool.editor.treeModelView?after=additions">
         <command commandId="io.github.p3chys.documentationarchi.insertReference">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.assetTarget"/></visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:ArchimateDiagramEditorContextMenuProvider?after=group_export">
         <command commandId="io.github.p3chys.documentationarchi.insertReference">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.assetTarget"/></visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:SketchEditorContextMenuProvider?after=group_export">
         <command commandId="io.github.p3chys.documentationarchi.insertReference">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.assetTarget"/></visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:CanvasEditorContextMenuProvider?after=group_export">
         <command commandId="io.github.p3chys.documentationarchi.insertReference">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.assetTarget"/></visibleWhen>
         </command>
      </menuContribution>
   </extension>

   <!-- Documentation Preview: the view, opened from the Window menu like Archi's own views, and from context menus -->
   <extension point="org.eclipse.ui.views">
      <view id="io.github.p3chys.documentationarchi.preview" name="Documentation Preview"
            class="io.github.p3chys.documentationarchi.ui.PreviewView" restorable="true"/>
   </extension>
   <extension point="org.eclipse.ui.commands">
      <command id="io.github.p3chys.documentationarchi.preview.open" name="Documentation Preview"
            description="Show the selected element, relationship or view as the documentation export shows it"/>
      <command id="io.github.p3chys.documentationarchi.preview.show" name="Show in Documentation Preview"
            description="Show this element, relationship or view as the documentation export shows it"/>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler commandId="io.github.p3chys.documentationarchi.preview.open" class="io.github.p3chys.documentationarchi.ui.ShowPreviewHandler"/>
      <handler commandId="io.github.p3chys.documentationarchi.preview.show" class="io.github.p3chys.documentationarchi.ui.ShowPreviewHandler"/>
   </extension>
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="menu:window?after=show_view_append">
         <command commandId="io.github.p3chys.documentationarchi.preview.open"/>
      </menuContribution>
      <menuContribution locationURI="popup:com.archimatetool.editor.treeModelView?after=additions">
         <command commandId="io.github.p3chys.documentationarchi.preview.show">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.exportable"/></visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:ArchimateDiagramEditorContextMenuProvider?after=group_export">
         <command commandId="io.github.p3chys.documentationarchi.preview.show">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.exportable"/></visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:SketchEditorContextMenuProvider?after=group_export">
         <command commandId="io.github.p3chys.documentationarchi.preview.show">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.exportable"/></visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:CanvasEditorContextMenuProvider?after=group_export">
         <command commandId="io.github.p3chys.documentationarchi.preview.show">
            <visibleWhen><reference definitionId="io.github.p3chys.documentationarchi.exportable"/></visibleWhen>
         </command>
      </menuContribution>
   </extension>

   <extension point="org.eclipse.ui.startup">
      <startup class="io.github.p3chys.documentationarchi.ui.ExportMarks"/>
   </extension>

   <extension point="org.eclipse.ui.preferencePages">
      <page id="io.github.p3chys.documentationarchi.prefs" name="Documentation Export"
            class="io.github.p3chys.documentationarchi.ui.DocumentationPreferencePage"/>
   </extension>

   <extension point="com.archimatetool.commandline.commandlineProvider">
      <commandlineProvider class="io.github.p3chys.documentationarchi.ui.ExportCommandLine"
            description="Export the current model as HTML, PDF and Confluence pages"
            id="io.github.p3chys.documentationarchi.commandlineProvider" name="Documentation Export"/>
   </extension>
</plugin>
