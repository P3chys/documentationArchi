Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: documentationArchi
Bundle-SymbolicName: io.github.p3chys.documentationarchi;singleton:=true
Bundle-Version: ${version}
Bundle-Vendor: documentationArchi
Bundle-Activator: io.github.p3chys.documentationarchi.ui.Activator
Bundle-ActivationPolicy: lazy
Bundle-RequiredExecutionEnvironment: JavaSE-11
Automatic-Module-Name: io.github.p3chys.documentationarchi
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.ui,
 org.eclipse.jface,
 org.eclipse.emf.ecore,
 org.eclipse.gef,
 com.archimatetool.model,
 com.archimatetool.editor,
 com.archimatetool.commandline;resolution:=optional
DynamicImport-Package: javax.*,org.w3c.*,org.xml.*
